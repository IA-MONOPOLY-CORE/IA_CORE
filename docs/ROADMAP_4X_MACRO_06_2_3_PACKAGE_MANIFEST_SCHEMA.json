{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ia-core://roadmap-4x-macro-06-2-3/package-manifest",
  "title": "V2.2.3 post-closure package manifest",
  "type": "object",
  "required": ["manifest_version", "content_set_sha256", "entries", "manifest_sha256"],
  "properties": {
    "manifest_version": {"const": "post_closure_package_manifest.v2.2.3"},
    "content_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {"type": "array", "minItems": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
