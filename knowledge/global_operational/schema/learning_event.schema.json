{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gokv.learning_event.v1",
  "title": "GOKV Learning Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "schema_version", "source_prompt", "source_phase", "source_checkpoint", "start_commit", "end_commit", "model", "effort", "mission_type", "planned_stations", "completed_stations", "commits", "tests", "duration", "operator_interventions", "retries", "rollbacks", "autonomous_blockers_resolved", "result", "observations", "candidate_knowledge_ids", "metrics_refs", "created_at"],
  "properties": {
    "event_id": {"type": "string"},
    "schema_version": {"const": "gokv.learning_event.v1"},
    "source_prompt": {"type": "string"},
    "source_phase": {"type": "string"},
    "source_checkpoint": {"type": ["string", "null"]},
    "start_commit": {"type": ["string", "null"]},
    "end_commit": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "mission_type": {"type": "string"},
    "planned_stations": {"type": "integer", "minimum": 0},
    "completed_stations": {"type": "integer", "minimum": 0},
    "commits": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "duration": {"type": ["number", "null"], "minimum": 0},
    "operator_interventions": {"type": "array"},
    "retries": {"type": ["integer", "null"], "minimum": 0},
    "rollbacks": {"type": ["integer", "null"], "minimum": 0},
    "autonomous_blockers_resolved": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "string"},
    "observations": {"type": "array", "items": {"type": "string"}},
    "candidate_knowledge_ids": {"type": "array", "items": {"type": "string"}},
    "metrics_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  }
}
